SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
WORKER_OWNER_ID=OWNER_UUID_FROM_PORTAL
WORKER_EMAIL=worker@example.com
WORKER_PASSWORD=CREATE_IN_SUPABASE_DASHBOARD
# Host path shared with Hermes; use --env-file .env.hp with Docker Compose.
HOMELAB_DATA_DIR=/srv/personal-os
HOMELAB_GROUP_ID=2000
CAPTURE_STORAGE=local
# Native worker paths; Compose overrides these with /homelab paths.
CAPTURE_LOCAL_DIR=/srv/personal-os/captures
DASHBOARD_INBOX_DIR=/srv/personal-os/inbox
EXTERNAL_AI_ENABLED=false
MODEL_MONTHLY_BUDGET_USD=8
TELEGRAM_ENABLED=false
# Optional capture bot only. Never reuse the Hermes gateway bot token here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=
TELEGRAM_OWNER_CHAT_ID=
GMAIL_ENABLED=false
GMAIL_LABEL_IDS=
GMAIL_ALLOWED_SENDERS=
# Labels listed above without a mapping remain financial evidence.
# Example: {"Label_Work":"work","Label_University":"education"}
GMAIL_LABEL_AREAS={}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_GMAIL_REFRESH_TOKEN=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_CONNECTIONS=[]
# Example: [{"id":"personal","calendarId":"primary","systemOwned":false}]
CALENDAR_WRITES_ENABLED=false
GITHUB_TOKEN=
GARMIN_ENABLED=false
