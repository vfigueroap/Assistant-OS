{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:web && npm run build:gym",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/gym", "destination": "/gym/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index?__route=/api/:path*" },
    { "source": "/gym/api/:path*", "destination": "/api/index?__route=/gym/api/:path*" },
    { "source": "/gym/", "destination": "/gym/index.html" },
    { "source": "/((?!api/|gym/|web/).*)", "destination": "/web/index.html" }
  ]
}
