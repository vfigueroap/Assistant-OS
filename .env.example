# Browser: publishable values only. Never place a secret key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server setup only; never used by HP workers or browser bundles.
SUPABASE_SECRET_KEY=
SETUP_OWNER_ID=
SETUP_WORKER_ID=
APP_ORIGIN=http://127.0.0.1:5173
API_PORT=8787
TZ=America/Santiago

# Optional worker. Use a separate registered account, never the owner password.
WORKER_EMAIL=
WORKER_PASSWORD_FILE=
WORKER_OWNER_ID=
WORKER_STATE_DIR=.local/worker
EXTRACTOR_URL=http://127.0.0.1:8080
EXTERNAL_AI_ENABLED=false
TELEGRAM_ENABLED=false
GMAIL_ENABLED=false

# Only when external inference is deliberately enabled, with verified prices.
OPENAI_API_KEY_FILE=
AI_MODEL=
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
MODEL_MONTHLY_BUDGET_USD=8
